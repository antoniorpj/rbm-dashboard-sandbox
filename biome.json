{
	"$schema": "https://biomejs.dev/schemas/1.9.3/schema.json",
	"organizeImports": { "enabled": false },
	"linter": { "enabled": false },
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": { "quoteStyle": "double", "semicolons": "always" }
	},
	"files": {
		"ignore": [
			".next",
			"node_modules",
			"package-lock.json",
			"public",
			"scripts/protected-files.json"
		]
	}
}
